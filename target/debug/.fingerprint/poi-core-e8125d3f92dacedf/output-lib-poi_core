\n    println!(\"{:?}\", foo);\n}\n\nfn main() {\n    // Calling the method is still fine, as i32 implements Debug.\n    some_func(5i32);\n\n    // This would fail to compile now:\n    // struct WithoutDebug;\n    // some_func(WithoutDebug);\n}\n```\n\nRust only looks at the signature of the called function, as such it must\nalready specify all requirements that will be used for every type parameter.\n"},"level":"error","spans":[{"file_name":"crates/core/src/contact_proof.rs","byte_start":883,"byte_end":895,"line_start":25,"line_end":25,"column_start":30,"column_end":42,"is_primary":true,"text":[{"text":"    fn from_json(s: &str) -> Result<Self>;","highlight_start":30,"highlight_end":42}],"label":"doesn't have a size known at compile-time","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"required by an implicit `Sized` bound in `std::result::Result`","code":null,"level":"note","spans":[{"file_name":"/rustc/59807616e1fa2540724bfbac14d7976d7e4a3860/library/core/src/result.rs","byte_start":21221,"byte_end":21242,"line_start":557,"line_end":557,"column_start":1,"column_end":22,"is_primary":true,"text":[],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[],"rendered":null},{"message":"consider further restricting `Self`","code":null,"level":"help","spans":[{"file_name":"crates/core/src/contact_proof.rs","byte_start":895,"byte_end":895,"line_start":25,"line_end":25,"column_start":42,"column_end":42,"is_primary":true,"text":[{"text":"    fn from_json(s: &str) -> Result<Self>;","highlight_start":42,"highlight_end":42}],"label":null,"suggested_replacement":" where Self: Sized","suggestion_applicability":"MachineApplicable","expansion":null}],"children":[],"rendered":null}],"rendered":"\u001b[1m\u001b[91merror[E0277]\u001b[0m\u001b[1m: the size for values of type `Self` cannot be known at compilation time\u001b[0m\n  \u001b[1m\u001b[94m--> \u001b[0mcrates/core/src/con